# ───────────────────────────────────────────────────────────────────
# ACA Autonomous Compliance Platform — Environment Template
# IMPORTANT: DO NOT commit real secrets, private keys, or API tokens.
# Copy this file to `.env` or `.env.local` for local development.
# ───────────────────────────────────────────────────────────────────

# Application Environment (development | staging | production)
VITE_APP_ENV=production

# Debug Mode (MUST BE false IN PRODUCTION TO PREVENT LOG/MEMORY LEAKS)
VITE_DEBUG_MODE=false

# Base API Gateway URL (Mock / Production)
VITE_API_BASE_URL=https://api.aca-tax.com/v1

# Government e-Filing Gateway Endpoints (Simulated / Live NETFILE / MeF / ITD)
VITE_CRA_NETFILE_ENDPOINT=https://netfile.cra-arc.gc.ca/v2026/gateway
VITE_IRS_MEF_ENDPOINT=https://mef.irs.gov/a2a/v2026/submission
VITE_ITD_EFILING_ENDPOINT=https://eportal.incometax.gov.in/iec/services/v2

# Security & Session Policy
VITE_SESSION_TIMEOUT_MINUTES=30
VITE_RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
VITE_RATE_LIMIT_AI_MAX_PER_MINUTE=15
VITE_ENABLE_AUDIT_LOGGING=true
VITE_STRICT_XSS_SANITIZATION=true
VITE_ENCRYPT_LOCAL_STORAGE=true
